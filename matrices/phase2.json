{
  "name": "phase2",
  "description": "Main matrix (docs/EXPERIMENT_PLAN.md): 44 cells x 5 interleaved repeats. Run with --estimates results/phase2/<arch>/pilot.csv and --stage input=224, then input=448.",
  "image": "onnx-docker-bench:latest",
  "out": "results/phase2/{arch}/results.csv",
  "seed": 20261016,
  "repeats": 5,
  "warmup": 50,
  "iters": 1000,
  "iter_cap": {"max_timed_s": 600, "min_iters": 300},
  "run_overhead_s": 15,
  "models": {"fp32": "models/resnet50.onnx", "int8": "models/resnet50.int8.onnx"},
  "factors": {
    "model": ["fp32", "int8"],
    "input": [224, 448],
    "cpus": [1, 2, 4],
    "intra": [0, "matched"],
    "spin": ["default", "off"]
  },
  "exclude": [
    {"cpus": 1, "intra": "matched", "spin": "off"}
  ]
}

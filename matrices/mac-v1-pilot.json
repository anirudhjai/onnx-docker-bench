{
  "name": "mac-v1-pilot",
  "description": "Stage 0 for the Mac v1 matrix: every cell once, short, to set iteration caps and ETAs for matrices/mac-v1.json.",
  "image": "onnx-docker-bench:latest",
  "out": "results/mac-v1/pilot.csv",
  "seed": 20261017,
  "repeats": 1,
  "warmup": 20,
  "iters": 100,
  "run_overhead_s": 5,
  "models": {"fp32": "models/resnet50.onnx", "int8": "models/resnet50.int8.onnx"},
  "factors": {
    "model": ["fp32", "int8"],
    "input": [224],
    "cpus": [1, 2, 4],
    "intra": [0, "matched"],
    "spin": ["default", "off"]
  },
  "exclude": [
    {"cpus": 1, "intra": "matched", "spin": "off"}
  ]
}
